# Custom Keybindings -->-->-->-->-->-->-->-->-->-->-->-->-->-->

# keybind = global:super+ctrl+shift+t = toggle_quick_terminal

## Split window:
keybind = shift+ctrl+l=new_split:left
keybind = shift+ctrl+u=new_split:up
keybind = shift+ctrl+r=new_split:right
keybind = shift+ctrl+d=new_split:down

### Navigation:
keybind = alt+arrow_right=goto_split:right
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_down=goto_split:down

## Tabs navigation:
keybind = ctrl+shift+o=toggle_tab_overview
keybind = ctrl+shift+n=prompt_tab_title
keybind = shift+alt+l=move_tab:-1
keybind = shift+alt+r=move_tab:1

## General Commands:
keybind = ctrl+shift+s=start_search
keybind = ctrl+shift+c=clear_screen
keybind = ctrl+shift+q=close_surface

## Un-binding:
keybind = alt+f4=show_on_screen_keyboard
# |-> Didn't work the unbind: action!

# Aestetics -->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->
theme = Gruber Darker
# theme = Adwaita Dark
language = en

## Background:
background = #14161B 
# background = #1D1D20 
#                |-> GNOME HIG background color.

## Cursor:
cursor-style = block
shell-integration-features = no-cursor
mouse-hide-while-typing

# split-divider-color = #1f1f21

# Window -->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->-->
title = "bash"
window-theme = ghostty

window-save-state = always

## Size:
window-height = 25
window-width = 125

## Tabs & Titlebar:
window-show-tab-bar = auto
gtk-tabs-location = hidden
# gtk-titlebar-style = tabs 
#   Remove title    <-|
# gtk-wide-tabs = false
gtk-toolbar-style = flat
window-subtitle = working-directory

# System integration -->-->-->-->-->-->-->-->-->-->-->-->-->-->

## Notifications:
notify-on-command-finish = unfocused
bell-features = no-title, system
#, audio
# bell-audio-path = ~/.config/ghostty/notification.mp3
# bell-audio-volume = 0.25
# |-> 0.0..1.0 default(0.5)

# Mouse:
mouse-scroll-multiplier = precision:0.1,discrete:3
clipboard-paste-protection = true

# ->-->-->-->-->-->-->That's the config!<--<--<--<--<--<--<--<-
